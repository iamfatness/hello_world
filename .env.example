# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Cisco CUCM
CUCM_HOST=cucm.example.com
CUCM_USERNAME=admin
CUCM_PASSWORD=changeme
CUCM_VERSION=14.0
CUCM_VERIFY_SSL=false

# Cisco CTI Route Point
CTI_ROUTE_POINT_DN=5000
CTI_DEVICE_NAME=ClockInRoutePoint

# UKG Pro Workforce Management API
UKG_BASE_URL=https://your-tenant.ultipro.com
UKG_API_KEY=your-api-key
UKG_CLIENT_ID=your-client-id
UKG_CLIENT_SECRET=your-client-secret
UKG_USERNAME=your-username
UKG_PASSWORD=your-password
UKG_USER_API_KEY=your-user-api-key

# SSO / OAuth2 (OIDC)
# Set SSO_ENABLED=true to require login for the admin portal.
# Supports any OAuth2/OIDC provider (Okta, Azure AD, Google, Keycloak, etc.)
SSO_ENABLED=false
SSO_PROVIDER_NAME=oauth
SSO_CLIENT_ID=your-client-id
SSO_CLIENT_SECRET=your-client-secret
# Option A: OIDC Discovery (recommended - auto-configures endpoints)
SSO_DISCOVERY_URL=https://your-provider.com/.well-known/openid-configuration
# Option B: Manual endpoint configuration (if no discovery URL)
SSO_AUTHORIZATION_ENDPOINT=https://your-provider.com/authorize
SSO_TOKEN_ENDPOINT=https://your-provider.com/token
SSO_USERINFO_ENDPOINT=https://your-provider.com/userinfo
SSO_SCOPES=openid email profile
# Access control: comma-separated lists (leave blank to allow all authenticated users)
SSO_ALLOWED_DOMAINS=example.com,company.com
SSO_ALLOWED_EMAILS=admin@example.com,ops@example.com
# Optional: JWT claim name that contains the user's role (e.g. "roles", "groups")
SSO_ADMIN_ROLE_CLAIM=

# Machine API Authentication
# When enabled, /ivr/*, /webhook/*, and /api/* endpoints require an API key
# (X-API-Key header or api_key query param). Admin SSO sessions also bypass
# this check. /webhook/health remains open for monitoring systems.
API_AUTH_ENABLED=false

# Session timeout (minutes). Default 480 = 8 hours.
SESSION_TIMEOUT_MINUTES=480

# Timezone for display (IANA format, e.g. America/New_York)
TIMEZONE=UTC

# Require employees to enter a PIN on the phone after their ID (prevents buddy punching)
REQUIRE_EMPLOYEE_PIN=false

# Database
DATABASE_URL=sqlite:///clock_records.db

# Logging
LOG_LEVEL=INFO
