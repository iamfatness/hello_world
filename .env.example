# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Cisco CUCM
CUCM_HOST=cucm.example.com
CUCM_USERNAME=admin
CUCM_PASSWORD=changeme
CUCM_VERSION=14.0
CUCM_VERIFY_SSL=false

# Cisco CTI Route Point
CTI_ROUTE_POINT_DN=5000
CTI_DEVICE_NAME=ClockInRoutePoint

# UKG Pro Workforce Management API
UKG_BASE_URL=https://your-tenant.ultipro.com
UKG_API_KEY=your-api-key
UKG_CLIENT_ID=your-client-id
UKG_CLIENT_SECRET=your-client-secret
UKG_USERNAME=your-username
UKG_PASSWORD=your-password
UKG_USER_API_KEY=your-user-api-key

# Database
DATABASE_URL=sqlite:///clock_records.db

# Logging
LOG_LEVEL=INFO
